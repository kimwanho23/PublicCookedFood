# Database
DB_URL=jdbc:mysql://localhost:3306/food?serverTimezone=UTC&characterEncoding=UTF-8&useUnicode=true
DB_USERNAME=root
DB_PASSWORD=change_me

# Docker Compose local database
MYSQL_DATABASE=food
MYSQL_APP_USER=app
MYSQL_APP_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me
MYSQL_HOST_PORT=3307

# Docker Hub image
DOCKERHUB_USERNAME=32up
DOCKERHUB_REPOSITORY=public-cooked-food
APP_IMAGE=32up/public-cooked-food:latest

# Mail
MAIL_USERNAME=
MAIL_PASSWORD=

# OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Redirect URI is derived from the current request base URL.
# Register each public callback URL in the provider console, for example:
# - http://localhost:8080/login/oauth2/code/google
# - http://localhost:8081/login/oauth2/code/google
# - https://your-domain/login/oauth2/code/google

# File upload root directory (images -> {FILE_DIR}/images, attachments -> {FILE_DIR}/files)
FILE_DIR=/C:/cookboardImageFile/

# Optional TEMP image cleanup scheduler overrides
# IMAGE_TEMP_CLEANUP_ENABLED=true
# IMAGE_TEMP_CLEANUP_TTL_HOURS=24
# IMAGE_TEMP_CLEANUP_BATCH_SIZE=100
# IMAGE_TEMP_CLEANUP_MAX_BATCHES_PER_RUN=20
# IMAGE_TEMP_CLEANUP_CRON=0 0 * * * *

# Optional schema bootstrap
# IMAGE_SCHEMA_AUTO_MIGRATE=false
# BOOTSTRAP_ADMIN_EMAIL=

# Optional Redis-backed HTTP session
# SESSION_STORE_TYPE=redis
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TIMEOUT=2s
# SESSION_REDIS_NAMESPACE=public-cooked-food:session
# SESSION_COOKIE_NAME=JSESSIONID

# Optional popular/recommendation scheduler overrides
# POPULAR_RECIPE_SCORE_ENABLED=false
# POPULAR_RECIPE_SCORE_INTERVAL_MS=300000
# POPULAR_RECIPE_SCORE_BATCH_SIZE=500
# POPULAR_RECIPE_SCORE_WEIGHT_VIEWS=1.00
# POPULAR_RECIPE_SCORE_WEIGHT_LIKES=0.00
# POPULAR_RECIPE_SCORE_WEIGHT_BOOKMARKS=1.30
# POPULAR_RECIPE_SCORE_FRESHNESS_WEIGHT=0.70
# POPULAR_RECIPE_SCORE_FRESHNESS_LAMBDA=0.03
# POPULAR_RECIPE_SCORE_ASYNC_CORE_POOL_SIZE=1
# POPULAR_RECIPE_SCORE_ASYNC_MAX_POOL_SIZE=2
# POPULAR_RECIPE_SCORE_ASYNC_QUEUE_CAPACITY=200
# POPULAR_RECIPE_SNAPSHOT_ENABLED=false
# POPULAR_RECIPE_SNAPSHOT_INTERVAL_MS=300000
# POPULAR_RECIPE_SNAPSHOT_TTL_MINUTES=30
# POPULAR_RECIPE_SNAPSHOT_TOP_N=100
# POPULAR_RECIPE_SNAPSHOT_FALLBACK_ENABLED=true
# POPULAR_RECIPE_SNAPSHOT_SLOT_BONUS=0.05
# POPULAR_RECIPE_SNAPSHOT_LUNCH_KEYWORDS=밥,국,찌개,면,볶음,덮밥
# POPULAR_RECIPE_SNAPSHOT_DINNER_KEYWORDS=구이,찜,탕,전골,조림,볶음
