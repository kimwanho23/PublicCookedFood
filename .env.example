# Optional schema bootstrap
# IMAGE_SCHEMA_AUTO_MIGRATE=false
# BOOTSTRAP_ADMIN_EMAIL=

# Optional popular/recommendation scheduler overrides
# POPULAR_RECIPE_SCORE_ENABLED=false
